{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Herdstead",
  "version": "0.1.0",
  "identifier": "dev.herdstead.desktop",
  "build": {
    "beforeDevCommand": "npm run prepare:runtime",
    "beforeBuildCommand": "npm run prepare:runtime",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "Herdstead", "width": 1500, "height": 960,
      "minWidth": 900, "minHeight": 600,
      "titleBarStyle": "Overlay", "hiddenTitle": true,
      "backgroundColor": "#0e1117"
    }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": { "binaries/herdstead": "herdstead" },
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "category": "DeveloperTool",
    "shortDescription": "A homestead for coding agents"
  }
}
